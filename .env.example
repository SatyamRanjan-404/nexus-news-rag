# ── Required ─────────────────────────────────────────────────────
# Groq API key — get free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Ingestion protection ─────────────────────────────────────────
# Secret key to protect the POST /v1/ingest endpoint from abuse
INGEST_API_KEY=change_me_to_a_random_secret

# ── LLM Model Selection ──────────────────────────────────────────
# Generator model (used for answer synthesis and claim checking)
GENERATOR_MODEL=llama-3.3-70b-versatile
# Judge model (used for faithfulness eval — different model reduces self-preference)
JUDGE_MODEL=llama-3.1-8b-instant
# Generator temperature
GENERATOR_TEMPERATURE=0.2
# Claim checker temperature (must be 0 for reproducibility)
CLAIM_TEMPERATURE=0.0

# ── Embedding ────────────────────────────────────────────────────
# HuggingFace model name for embeddings (must match the indexed collection)
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Embedding batch size (reduce if you hit OOM on CPU)
EMBEDDING_BATCH_SIZE=64

# ── Chunking ─────────────────────────────────────────────────────
# Strategy: "recursive" or "semantic"
CHUNKING_STRATEGY=recursive
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ── Retrieval ────────────────────────────────────────────────────
# Number of candidates to fetch before reranking
RERANK_CANDIDATE_K=20
# Final number of context chunks passed to the LLM
FINAL_K=5
# RRF k constant (default 60, standard)
RRF_K=60

# ── ChromaDB ─────────────────────────────────────────────────────
# Path to persistent ChromaDB directory
CHROMA_PATH=./data/chroma_db
# Main collection name
CHROMA_COLLECTION=news_collection
# Eval collection name (separate from live data)
CHROMA_EVAL_COLLECTION=news_eval

# ── Ingestion ────────────────────────────────────────────────────
# Fetch scheduler interval in minutes
INGEST_INTERVAL_MINUTES=15
# Tier 3 (news) retention in days
RETENTION_DAYS_TIER3=14
# Tier 1 (official) retention in days
RETENTION_DAYS_TIER1=180
# Tier 2 (fact-checker) retention in days
RETENTION_DAYS_TIER2=365
# Trafilatura fetch timeout in seconds
FETCH_TIMEOUT_SECONDS=5
# Max concurrent fetch workers
FETCH_WORKERS=10

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_ASK=20/minute
RATE_LIMIT_CLAIM=10/minute

# ── API ──────────────────────────────────────────────────────────
# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:8501,http://localhost:3000
# API host and port
API_HOST=0.0.0.0
API_PORT=8000

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
